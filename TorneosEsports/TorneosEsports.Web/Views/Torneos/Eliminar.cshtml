@* Confirmación antes de eliminar (solo administrador). *@
@model Torneo
@{
    ViewData["Title"] = "Eliminar torneo";
}

<h1 class="h3 mb-3">¿Eliminar el torneo de @Model.Juego?</h1>

<div class="alert alert-warning">
    Esta acción no se puede deshacer.
    @if (Model.Equipos.Count > 0)
    {
        <strong>El torneo tiene @Model.Equipos.Count equipos inscritos y no se podrá eliminar.</strong>
    }
</div>

<dl class="row">
    <dt class="col-sm-3">Evento</dt>
    <dd class="col-sm-9">@Model.Evento?.Nombre</dd>
    <dt class="col-sm-3">Formato</dt>
    <dd class="col-sm-9">@Model.Formato</dd>
    <dt class="col-sm-3">Cupo</dt>
    <dd class="col-sm-9">@Model.CupoEquipos equipos</dd>
</dl>

<form asp-action="Eliminar" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Detalle" asp-route-id="@Model.Id" class="btn btn-link">Cancelar</a>
</form>

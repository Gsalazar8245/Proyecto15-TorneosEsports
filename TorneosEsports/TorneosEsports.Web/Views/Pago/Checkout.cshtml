@model TorneosEsports.Web.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Pagar";
}

<h2>Pagar</h2>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row">
    <div class="col-md-6">
        <h5>Resumen</h5>
        <table class="table table-sm">
            <thead>
                <tr><th>Descripción</th><th>Cant.</th><th class="text-end">Subtotal</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Descripcion</td>
                        <td>@item.Cantidad</td>
                        <td class="text-end">₡@item.Subtotal.ToString("N0")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><th colspan="2" class="text-end">Total</th><th class="text-end">₡@Model.Total.ToString("N0")</th></tr>
            </tfoot>
        </table>
    </div>

    <div class="col-md-6">
        <h5>Tarjeta</h5>
        <form asp-action="Checkout" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Titular" class="form-label"></label>
                <input asp-for="Titular" class="form-control" autocomplete="cc-name" />
                <span asp-validation-for="Titular" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NumeroTarjeta" class="form-label"></label>
                <input asp-for="NumeroTarjeta" class="form-control" inputmode="numeric" maxlength="16" autocomplete="cc-number" />
                <span asp-validation-for="NumeroTarjeta" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Pagar ₡@Model.Total.ToString("N0")</button>
            <a asp-controller="Carrito" asp-action="Index" class="btn btn-link">Volver al carrito</a>
        </form>

        <div class="alert alert-secondary mt-3 small">
            <strong>Pasarela de prueba:</strong> no se cobra dinero real.
            Una tarjeta que termina en <code>0000</code> se rechaza por fondos;
            un total mayor a ₡250 000 se rechaza por límite; cualquier otra se aprueba
            (por ejemplo <code>4111111111111111</code>).
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

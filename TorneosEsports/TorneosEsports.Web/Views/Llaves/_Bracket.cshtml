@* Dibuja las rondas y los partidos. Solo muestra datos: el servicio ya calculó todo. *@
@model LlavesViewModel
@{
    bool esAdmin = User.IsInRole(TorneosEsports.Web.Controllers.TorneosController.RolAdministrador);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.Juego</h1>
        <div class="text-muted">@Model.Evento · @Model.Formato · @Model.EquiposPagados equipos</div>
    </div>
    <partial name="~/Views/Torneos/_EstadoTorneo.cshtml" model="Model.Estado" />
</div>

@if (Model.Campeon is not null)
{
    <div class="alert alert-warning text-center fs-5" role="status">🏆 Campeón: <strong>@Model.Campeon</strong></div>
}

@if (!Model.TieneLlaves)
{
    <p class="text-muted">Las llaves se generan automáticamente cuando el administrador cierra las inscripciones.</p>
}
else
{
    <div class="bracket">
        @foreach (var ronda in Model.Rondas)
        {
            <section class="bracket-ronda" aria-label="@ronda.Nombre">
                <h2 class="bracket-titulo">@ronda.Nombre</h2>
                @foreach (var partido in ronda.Partidos)
                {
                    <article class="bracket-partido @(partido.EsBye ? "es-bye" : "")">
                        @foreach (var (equipoId, nombre) in new[] { (partido.EquipoAId, partido.EquipoA), (partido.EquipoBId, partido.EquipoB) })
                        {
                            bool gano = equipoId.HasValue && equipoId == partido.GanadorId;
                            bool perdio = partido.GanadorId.HasValue && equipoId.HasValue && !gano;
                            <div class="bracket-equipo @(gano ? "ganador" : "") @(perdio ? "perdedor" : "")">
                                <span>@nombre</span>
                                @if (gano)
                                {
                                    <span aria-label="ganador">✓</span>
                                }
                                else if (esAdmin && partido.ListoParaJugar && equipoId.HasValue)
                                {
                                    <form asp-controller="Llaves" asp-action="RegistrarResultado" asp-route-partidoId="@partido.Id" method="post" class="d-inline">
                                        <input type="hidden" name="ganadorId" value="@equipoId" />
                                        <input type="hidden" name="torneoId" value="@Model.TorneoId" />
                                        <button type="submit" class="btn btn-sm btn-outline-success py-0">Gana</button>
                                    </form>
                                }
                            </div>
                        }
                    </article>
                }
            </section>
        }
    </div>
}

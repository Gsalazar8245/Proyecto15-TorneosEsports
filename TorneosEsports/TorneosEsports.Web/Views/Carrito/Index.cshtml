@model TorneosEsports.Web.Models.ViewModels.CarritoViewModel
@{
    ViewData["Title"] = "Carrito";
}

<h2>Mi carrito</h2>

@if (Model.EstaVacio)
{
    <p>Tu carrito está vacío.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Descripción</th><th>Cant.</th><th>Precio</th><th>Subtotal</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Descripcion</td>
                    <td>@item.Cantidad</td>
                    <td>₡@item.PrecioUnitario.ToString("N0")</td>
                    <td>₡@item.Subtotal.ToString("N0")</td>
                    <td>
                        <form asp-action="Quitar" method="post">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button class="btn btn-sm btn-outline-danger">Quitar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr><th colspan="3" class="text-end">Total</th><th>₡@Model.Total.ToString("N0")</th><th></th></tr>
        </tfoot>
    </table>
    <!-- Deilyn conecta aquí el botón de pago (checkout) -->
}